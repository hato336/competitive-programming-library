	"tree_diameter": {
        "prefix": "tree_diameter",
        "body": [
            "pair<ll,vll> tree_diameter(ll n,vvpll edge){",
            "    ll start = 0;",
            "    vll dist(n,1LL<<60);",
            "    dist[start] = 0;",
            "    queue<ll> d;",
            "    d.push(start);",
            "    while(!d.empty()){",
            "        ll now = d.front();",
            "        d.pop();",
            "        for(auto [to,cost]:edge[now]){",
            "            if(dist[to] > dist[now] + cost){",
            "                dist[to] = dist[now] + cost;",
            "                d.push(to);",
            "            }",
            "        }",
            "    }",
            "",
            "    ll s = 0;",
            "    ll temp = 0;",
            "    rep(i,n){",
            "        if(temp < dist[i]){",
            "            temp = dist[i];",
            "            s = i;",
            "        }",
            "    }",
            "",
            "    start = s;",
            "    dist.clear();",
            "    dist.resize(n,1LL<<60);",
            "    dist[start] = 0;",
            "    d.push(start);",
            "    vll res(n,-1);",
            "    while(!d.empty()){",
            "        ll now = d.front();",
            "        d.pop();",
            "        for(auto [to,cost]:edge[now]){",
            "            if(dist[to] > dist[now] + cost){",
            "                dist[to] = dist[now] + cost;",
            "                d.push(to);",
            "                res[to] = now;",
            "            }",
            "        }",
            "    }",
            "",
            "    temp = 0;",
            "    ll t = 0;",
            "    rep(i,n){",
            "        if(temp < dist[i]){",
            "            temp = dist[i];",
            "            t = i;",
            "        }",
            "    }",
            "    vll path;",
            "    while(t != -1){",
            "        path.push_back(t);",
            "        t = res[t];",
            "    }",
            "    return make_pair(temp,path);",
            "}",
        ],
        "description": ""
    },
    "prime_enumerate":{
        "prefix": "prime_enumerate",
        "body": [
            "//https://nyaannyaan.github.io/library/prime/prime-enumerate.hpp",
            "",
            "// Prime Sieve {2, 3, 5, 7, 11, 13, 17, ...}",
            "vector<int> prime_enumerate(int N) {",
            "  vector<bool> sieve(N / 3 + 1, 1);",
            "  for (int p = 5, d = 4, i = 1, sqn = sqrt(N); p <= sqn; p += d = 6 - d, i++) {",
            "    if (!sieve[i]) continue;",
            "    for (int q = p * p / 3, r = d * p / 3 + (d * p % 3 == 2), s = 2 * p,",
            "             qe = sieve.size();",
            "         q < qe; q += r = s - r)",
            "      sieve[q] = 0;",
            "  }",
            "  vector<int> ret{2, 3};",
            "  for (int p = 5, d = 4, i = 1; p <= N; p += d = 6 - d, i++)",
            "    if (sieve[i]) ret.push_back(p);",
            "  while (!ret.empty() && ret.back() > N) ret.pop_back();",
            "  return ret;",
            "}"
        ]
    },
    "prime_test":{
        "prefix": "prime_test",
        "body": [
            "long long mod_mul(long long a, long long b, long long mod) {",
            "    return (__int128)a * b % mod;",
            "}",
            "",
            "long long mod_pow(long long a, long long b, long long mod) {",
            "    long long result = 1;",
            "    a %= mod;",
            "    while (b > 0) {",
            "        if (b & 1) result = mod_mul(result, a, mod);",
            "        a = mod_mul(a, a, mod);",
            "        b >>= 1;",
            "    }",
            "    return result;",
            "}",
            "",
            "bool MillerRabin(ll x){",
            "    ",
            "    if(x <= 1){return false;}",
            "    if(x == 2){return true;}",
            "    if((x & 1) == 0){return false;}",
            "    vll test;",
            "    if(x < (1 << 30)){",
            "        test = {2, 7, 61};",
            "    } ",
            "    else{",
            "        test = {2, 325, 9375, 28178, 450775, 9780504, 1795265022};",
            "    }",
            "    ll s = 0;",
            "    ll d = x - 1;",
            "    while((d & 1) == 0){",
            "        s++;",
            "        d >>= 1;",
            "    }",
            "    for(ll i:test){",
            "        if(x <= i){return true;}",
            "        ll y = mod_pow(i,d,x);",
            "        if(y == 1 || y == x - 1){continue;}",
            "        ll c = 0;",
            "        for(int j=0;j<s-1;j++){",
            "            y = mod_mul(y,y,x);",
            "            if(y == x - 1){",
            "                c = 1;",
            "                break;",
            "            }",
            "        }",
            "        if(c == 0){",
            "            return false;",
            "        }",
            "    }",
            "    return true;",
            "}",
        ]
    },
    "combination":{
        "prefix": "combination",
        "body": [
            "class Comb {",
            "public:",
            "    vector<ll> fact, fact_inv;",
            "    ll mod;",
            "",
            "    Comb(int n, ll mod) : fact(n + 1), fact_inv(n + 1), mod(mod) {",
            "        fact[0] = fact[1] = 1;",
            "        fact_inv[0] = fact_inv[1] = 1;",
            "",
            "        for (int i = 2; i <= n; ++i) {",
            "            fact[i] = fact[i - 1] * i % mod;",
            "        }",
            "",
            "        int m = min(n, int(mod - 1));",
            "        fact_inv[m] = mod_pow(fact[m], mod - 2);",
            "",
            "        for (int i = m - 1; i >= 2; --i) {",
            "            fact_inv[i] = fact_inv[i + 1] * (i + 1) % mod;",
            "        }",
            "    }",
            "",
            "    ll ncr(int n, int r) const {",
            "        if (n < r || r < 0) return 0;",
            "        return fact[n] * fact_inv[r] % mod * fact_inv[n - r] % mod;",
            "    }",
            "",
            "    ll nhr(int n, int r) const {",
            "        return ncr(n + r - 1, r);",
            "    }",
            "",
            "private:",
            "    ll mod_pow(ll x, ll y) const {",
            "        ll res = 1;",
            "        while (y > 0) {",
            "            if (y & 1) res = res * x % mod;",
            "            x = x * x % mod;",
            "            y >>= 1;",
            "        }",
            "        return res;",
            "    }",
            "};"
        ]
    },
    "divisor":{
        "prefix": "divisor",
        "body": [
            "vector<ll> divisor(ll n){",
            "    vector<ll> res;",
            "    for(ll i = 1; i * i <= n; i++){",
            "        if(n % i == 0){",
            "            res.push_back(i);",
            "            if(i * i != n){",
            "                res.push_back(n / i);",
            "            }",
            "        }",
            "    }",
            "    sort(res.begin(), res.end());",
            "    return res;",
            "}"
        ]
    },
    "osak":{
        "prefix": "osak",
        "body": [
            "//https://nyaannyaan.github.io/library/prime/osak.hpp",
            "#line 2 "prime/osak.hpp"",
            "",
            "#line 2 "prime/factor-enumerate.hpp"",
            "",
            "vector<int> factor_enumerate(int N) {",
            "  vector<int> lp(N + 1, 0);",
            "  if (N < 2) return lp;",
            "  vector<int> pr{2, 3};",
            "  for (int i = 2; i <= N; i += 2) lp[i] = 2;",
            "  for (int i = 3; i <= N; i += 6) lp[i] = 3;",
            "  for (int i = 5, d = 4; i <= N; i += d = 6 - d) {",
            "    if (lp[i] == 0) {",
            "      lp[i] = i;",
            "      pr.push_back(i);",
            "    }",
            "    for (int j = 2; j < (int)pr.size() && i * pr[j] <= N; ++j) {",
            "      lp[i * pr[j]] = pr[j];",
            "      if (pr[j] == lp[i]) break;",
            "    }",
            "  }",
            "  return lp;",
            "}",
            "#line 4 "prime/osak.hpp"",
            "",
            "template <int MAX>",
            "vector<int> osak(int n) {",
            "  static vector<int> f = factor_enumerate(MAX);",
            "  vector<int> ret;",
            "  while (f[n]) ret.push_back(f[n]), n /= f[n];",
            "  return ret;",
            "}",
            "",
            "template <int MAX>",
            "vector<pair<int, int>> osak_table(int n) {",
            "  static vector<int> f = factor_enumerate(MAX);",
            "  vector<pair<int, int>> v;",
            "  for (; f[n]; n /= f[n]) {",
            "    if (v.empty() || v.back().first != f[n]) {",
            "      v.emplace_back(f[n], 1);",
            "    } else {",
            "      v.back().second++;",
            "    }",
            "  }",
            "  return v;",
            "}",
            "",
            "template <int MAX>",
            "vector<int> osak_divisors(int n) {",
            "  if(n == 0) return {};",
            "  if(n == 1) return vector<int>(1, 1);",
            "  auto p = osak_table<MAX>(n);",
            "  vector<int> ds;",
            "",
            "  auto dfs = [&](auto r, int i, int c) {",
            "    if (i == (int)p.size()) {",
            "      ds.push_back(c);",
            "      return;",
            "    }",
            "    for (int j = 0; j <= p[i].second; j++) {",
            "      r(r, i + 1, c);",
            "      c *= p[i].first;",
            "    }",
            "  };",
            "",
            "  dfs(dfs, 0, 1);",
            "  sort(begin(ds), end(ds));",
            "  return ds;",
            "}",
        ]
    },
        "lca": {
        "prefix": "lca",
        "body": [
            "//https://judge.yosupo.jp/submission/293161",
            "class LCA {",
            "public:",
            "    int n;",
            "    vector<vector<long long>> edge;",
            "    vector<pair<int, int>> et; ",
            "    vector<int> IN;            ",
            "    vector<vector<pair<int, int>>> table; ",
            "    vector<int> look;          ",
            "",
            "    LCA(int n_, const vector<vector<long long>>& edge_) : n(n_), edge(edge_) {",
            "        IN.assign(n, -1);",
            "        vector<long long> dist(n, 1e18);",
            "        vector<int> p(n, -1);",
            "        vector<int> d;",
            "",
            "        dist[0] = 0;",
            "        d.push_back(~0);",
            "        d.push_back(0);  ",
            "",
            "        int t = 0;",
            "        while (!d.empty()) {",
            "            int now = d.back(); d.pop_back();",
            "            if (now < 0) {",
            "                now = ~now;",
            "                et.emplace_back(dist[p[now]], p[now]);",
            "            } else {",
            "                IN[now] = t;",
            "                et.emplace_back(dist[now], now);",
            "                for (int to : edge[now]) {",
            "                    if (to == p[now]) continue;",
            "                    p[to] = now;",
            "                    dist[to] = dist[now] + 1;",
            "                    d.push_back(~to);",
            "                    d.push_back(to);",
            "                }",
            "            }",
            "            ++t;",
            "        }",
            "",
            "        int m = et.size();",
            "        int k = 0;",
            "        while ((1 << k) <= m) k++;",
            "        table.assign(k, vector<pair<int, int>>(m, {1e9, -1}));",
            "",
            "        for (int i = 0; i < m; i++) {",
            "            table[0][i] = et[i];",
            "        }",
            "",
            "        for (int j = 1; j < k; j++) {",
            "            for (int i = 0; i + (1 << j) <= m; i++) {",
            "                table[j][i] = min(table[j - 1][i], table[j - 1][i + (1 << (j - 1))]);",
            "            }",
            "        }",
            "",
            "        look.resize(2 * n + 1);",
            "        for (int i = 2; i <= 2 * n; i++) {",
            "            look[i] = look[i >> 1] + 1;",
            "        }",
            "    }",
            "",
            "    // u と v の LCA を求める（戻り値は {depth, node}）",
            "    pair<int, int> calc(int u, int v) {",
            "        if (u == 0 || v == 0) return {0, 0};",
            "        int l = IN[u], r = IN[v];",
            "        if (l > r) swap(l, r);",
            "        r++;",
            "        int x = look[r - l];",
            "        return min(table[x][l], table[x][r - (1 << x)]);",
            "    }",
            "};",
        ],
        "description": ""
    },
    "vertexaddsubtreesum":{
        "prefix": "vertexaddsubtreesum",
        "body": [
            "//https://judge.yosupo.jp/submission/292011",
            "ll op(ll a, ll b) { return a + b; }",
            "ll e() { return 0LL; }",
            "",
            "struct VertexAddSubtreeSum {",
            "    int n, t = 0;",
            "    vector<vector<int>> edge;",
            "    vector<int> in, out;",
            "    segtree<ll, op, e> st;",
            "",
            "    VertexAddSubtreeSum(int n_, const vector<vector<int>>& adj, const vector<ll>& values)",
            "        : n(n_), edge(adj), in(n), out(n), st(n) {",
            "        build(0);",
            "",
            "        vector<ll> euler_values(n);",
            "        for (int v = 0; v < n; ++v) {",
            "            euler_values[in[v]] = values[v];",
            "        }",
            "        st = segtree<ll, op, e>(euler_values);",
            "    }",
            "",
            "    void dfs(int v, int p) {",
            "        in[v] = t++;",
            "        for (int u : edge[v]) {",
            "            if (u == p) continue;",
            "            dfs(u, v);",
            "        }",
            "        out[v] = t;",
            "    }",
            "",
            "    void build(int root) {",
            "        t = 0;",
            "        dfs(root, -1);",
            "    }",
            "",
            "    void add(int v, ll x) {",
            "        st.set(in[v], st.get(in[v]) + x);",
            "    }",
            "",
            "    ll get(int v) {",
            "        return st.get(in[v]);",
            "    }",
            "",
            "    ll subtree_sum(int v) {",
            "        return st.prod(in[v], out[v]);",
            "    }",
            "};"
        ]
    },
    "cht":{
        "prefix": "cht",
        "body": [
            "//https://atcoder.jp/contests/dp/submissions/66638516",
            "deque<pair<ll, ll>> deq;",
            "",
            "bool check(const pair<ll, ll>& f1, ",
            "           const pair<ll, ll>& f2, ",
            "           const pair<ll, ll>& f3) {",
            "    return (f2.first - f1.first) * (f3.second - f2.second) >= (f2.second - f1.second) * (f3.first - f2.first);",
            "}",
            "",
            "ll f(const pair<ll, ll>& line, ll x) {",
            "    return line.first * x + line.second;",
            "}",
            "",
            "void add_line(ll a, ll b) {",
            "    pair<ll, ll> f1 = {a, b};",
            "    while (deq.size() >= 2 && check(deq[deq.size() - 2], deq.back(), f1)) {",
            "        deq.pop_back();",
            "    }",
            "    deq.push_back(f1);",
            "}",
            "",
            "ll query(ll x) {",
            "    while (deq.size() >= 2 && f(deq[0], x) >= f(deq[1], x)) {",
            "        deq.pop_front();",
            "    }",
            "    return f(deq[0], x);",
            "}"
        ]
    },
        "BMBM": {
        "prefix": "BMBM",
        "body": [
            "//https://nyaannyaan.github.io/library/fps/ntt-friendly-fps.hpp",
            "#line 2 \"fps/ntt-friendly-fps.hpp\"",
            "",
            "#line 2 \"ntt/ntt.hpp\"",
            "",
            "template <typename mint>",
            "struct NTT {",
            "  static constexpr uint32_t get_pr() {",
            "    uint32_t _mod = mint::get_mod();",
            "    using u64 = uint64_t;",
            "    u64 ds[32] = {};",
            "    int idx = 0;",
            "    u64 m = _mod - 1;",
            "    for (u64 i = 2; i * i <= m; ++i) {",
            "      if (m % i == 0) {",
            "        ds[idx++] = i;",
            "        while (m % i == 0) m /= i;",
            "      }",
            "    }",
            "    if (m != 1) ds[idx++] = m;",
            "",
            "    uint32_t _pr = 2;",
            "    while (1) {",
            "      int flg = 1;",
            "      for (int i = 0; i < idx; ++i) {",
            "        u64 a = _pr, b = (_mod - 1) / ds[i], r = 1;",
            "        while (b) {",
            "          if (b & 1) r = r * a % _mod;",
            "          a = a * a % _mod;",
            "          b >>= 1;",
            "        }",
            "        if (r == 1) {",
            "          flg = 0;",
            "          break;",
            "        }",
            "      }",
            "      if (flg == 1) break;",
            "      ++_pr;",
            "    }",
            "    return _pr;",
            "  };",
            "",
            "  static constexpr uint32_t mod = mint::get_mod();",
            "  static constexpr uint32_t pr = get_pr();",
            "  static constexpr int level = __builtin_ctzll(mod - 1);",
            "  mint dw[level], dy[level];",
            "",
            "  void setwy(int k) {",
            "    mint w[level], y[level];",
            "    w[k - 1] = mint(pr).pow((mod - 1) / (1 << k));",
            "    y[k - 1] = w[k - 1].inverse();",
            "    for (int i = k - 2; i > 0; --i)",
            "      w[i] = w[i + 1] * w[i + 1], y[i] = y[i + 1] * y[i + 1];",
            "    dw[1] = w[1], dy[1] = y[1], dw[2] = w[2], dy[2] = y[2];",
            "    for (int i = 3; i < k; ++i) {",
            "      dw[i] = dw[i - 1] * y[i - 2] * w[i];",
            "      dy[i] = dy[i - 1] * w[i - 2] * y[i];",
            "    }",
            "  }",
            "",
            "  NTT() { setwy(level); }",
            "",
            "  void fft4(vector<mint> &a, int k) {",
            "    if ((int)a.size() <= 1) return;",
            "    if (k == 1) {",
            "      mint a1 = a[1];",
            "      a[1] = a[0] - a[1];",
            "      a[0] = a[0] + a1;",
            "      return;",
            "    }",
            "    if (k & 1) {",
            "      int v = 1 << (k - 1);",
            "      for (int j = 0; j < v; ++j) {",
            "        mint ajv = a[j + v];",
            "        a[j + v] = a[j] - ajv;",
            "        a[j] += ajv;",
            "      }",
            "    }",
            "    int u = 1 << (2 + (k & 1));",
            "    int v = 1 << (k - 2 - (k & 1));",
            "    mint one = mint(1);",
            "    mint imag = dw[1];",
            "    while (v) {",
            "      // jh = 0",
            "      {",
            "        int j0 = 0;",
            "        int j1 = v;",
            "        int j2 = j1 + v;",
            "        int j3 = j2 + v;",
            "        for (; j0 < v; ++j0, ++j1, ++j2, ++j3) {",
            "          mint t0 = a[j0], t1 = a[j1], t2 = a[j2], t3 = a[j3];",
            "          mint t0p2 = t0 + t2, t1p3 = t1 + t3;",
            "          mint t0m2 = t0 - t2, t1m3 = (t1 - t3) * imag;",
            "          a[j0] = t0p2 + t1p3, a[j1] = t0p2 - t1p3;",
            "          a[j2] = t0m2 + t1m3, a[j3] = t0m2 - t1m3;",
            "        }",
            "      }",
            "      // jh >= 1",
            "      mint ww = one, xx = one * dw[2], wx = one;",
            "      for (int jh = 4; jh < u;) {",
            "        ww = xx * xx, wx = ww * xx;",
            "        int j0 = jh * v;",
            "        int je = j0 + v;",
            "        int j2 = je + v;",
            "        for (; j0 < je; ++j0, ++j2) {",
            "          mint t0 = a[j0], t1 = a[j0 + v] * xx, t2 = a[j2] * ww,",
            "               t3 = a[j2 + v] * wx;",
            "          mint t0p2 = t0 + t2, t1p3 = t1 + t3;",
            "          mint t0m2 = t0 - t2, t1m3 = (t1 - t3) * imag;",
            "          a[j0] = t0p2 + t1p3, a[j0 + v] = t0p2 - t1p3;",
            "          a[j2] = t0m2 + t1m3, a[j2 + v] = t0m2 - t1m3;",
            "        }",
            "        xx *= dw[__builtin_ctzll((jh += 4))];",
            "      }",
            "      u <<= 2;",
            "      v >>= 2;",
            "    }",
            "  }",
            "",
            "  void ifft4(vector<mint> &a, int k) {",
            "    if ((int)a.size() <= 1) return;",
            "    if (k == 1) {",
            "      mint a1 = a[1];",
            "      a[1] = a[0] - a[1];",
            "      a[0] = a[0] + a1;",
            "      return;",
            "    }",
            "    int u = 1 << (k - 2);",
            "    int v = 1;",
            "    mint one = mint(1);",
            "    mint imag = dy[1];",
            "    while (u) {",
            "      // jh = 0",
            "      {",
            "        int j0 = 0;",
            "        int j1 = v;",
            "        int j2 = v + v;",
            "        int j3 = j2 + v;",
