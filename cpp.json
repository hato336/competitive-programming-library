        "zeta_transform": {
        "prefix": "zeta_transform",
        "body": [
            "//https://nyaannyaan.github.io/library/prime/prime-enumerate.hpp",
            "",
            "// Prime Sieve {2, 3, 5, 7, 11, 13, 17, ...}",
            "vector<int> prime_enumerate(int N) {",
            "  vector<bool> sieve(N / 3 + 1, 1);",
            "  for (int p = 5, d = 4, i = 1, sqn = sqrt(N); p <= sqn; p += d = 6 - d, i++) {",
            "    if (!sieve[i]) continue;",
            "    for (int q = p * p / 3, r = d * p / 3 + (d * p % 3 == 2), s = 2 * p,",
            "             qe = sieve.size();",
            "         q < qe; q += r = s - r)",
            "      sieve[q] = 0;",
            "  }",
            "  vector<int> ret{2, 3};",
            "  for (int p = 5, d = 4, i = 1; p <= N; p += d = 6 - d, i++)",
            "    if (sieve[i]) ret.push_back(p);",
            "  while (!ret.empty() && ret.back() > N) ret.pop_back();",
            "  return ret;",
            "}",
            "",
            "//based on https://nyaannyaan.github.io/library/multiplicative-function/divisor-multiple-transform.hpp",
            "",
            "template <typename T>",
            "void divisor_zeta_transform(vector<T> &a){",
            "    int N = a.size() - 1;",
            "    auto sieve = prime_enumerate(N);",
            "    for(auto &p : sieve){",
            "        for(int k = 1; k * p <= N; ++k){",
            "            a[k * p] += a[k];",
            "        }",
            "    }",
            "    return;",
            "}",
            "template <typename T>",
            "void divisor_mobius_transform(vector<T> &a) {",
            "    int N = a.size() - 1;",
            "    auto sieve = prime_enumerate(N);",
            "    for(auto &p : sieve){",
            "        for(int k = N / p; k > 0; --k) {",
            "            a[k * p] -= a[k];",
            "        }",
            "    }",
            "    return;",
            "}",
            "template <typename T>",
            "void multiple_zeta_transform(vector<T> &a) {",
            "    int N = a.size() - 1;",
            "    auto sieve = prime_enumerate(N);",
            "    for(auto &p : sieve){",
            "        for (int k = N / p; k > 0; --k){",
            "            a[k] += a[k * p];",
            "        }",
            "    }",
            "    return;",
            "}",
            "template <typename T>",
            "void multiple_mobius_transform(vector<T> &a) {",
            "    int N = a.size() - 1;",
            "    auto sieve = prime_enumerate(N);",
            "    for(auto &p : sieve){",
            "        for (int k = 1; k * p <= N; ++k){",
            "            a[k] -= a[k * p];",
            "        }",
            "    }",
            "    return;",
            "}",
        ],
        "description": ""
    },
        "CentroidDecomposition": {
        "prefix": "CentroidDecomposition",
        "body": [
            "// based on https://ei1333.github.io/luzhiled/snippets/tree/centroid-decomposition.html",
            "// https://atcoder.jp/contests/abc362/submissions/67242790",
            "",
            "struct CentroidDecomposition {",
            "    const vector<vector<long long>> &g;",
            "    vector<int> sub;",
            "    vector<vector<int>> belong;",
            "    vector<vector<int>> centroid_nodes;",
            "    vector<int> centroid_depth;",
            "    vector<bool> v;",
            "    vector<vector<long long>> tree;",
            "    int root;",
            "",
            "    CentroidDecomposition(const vector<vector<long long>> &g)",
            "        : g(g),",
            "          sub(g.size()),",
            "          v(g.size()),",
            "          belong(g.size()),",
            "          centroid_nodes(g.size()),",
            "          centroid_depth(g.size(), -1),",
            "          tree(g.size()) {",
            "        root = build();",
            "    }",
            "",
            "    int build_dfs(int idx, int par) {",
            "        sub[idx] = 1;",
            "        for (auto &to : g[idx]) {",
            "            if (to == par || v[to]) continue;",
            "            sub[idx] += build_dfs(to, idx);",
            "        }",
            "        return sub[idx];",
            "    }",
            "",
            "    int search_centroid(int idx, int par, int mid) {",
            "        for (auto &to : g[idx]) {",
            "            if (to == par || v[to]) continue;",
            "            if (sub[to] > mid) return search_centroid(to, idx, mid);",
            "        }",
            "        return idx;",
            "    }",
            "",
            "    void belong_dfs(int idx, int par, int centroid) {",
            "        belong[idx].emplace_back(centroid);",
            "        centroid_nodes[centroid].emplace_back(idx);",
            "        for (auto &to : g[idx]) {",
            "            if (to == par || v[to]) continue;",
            "            belong_dfs(to, idx, centroid);",
            "        }",
            "    }",
            "",
            "    int build(int idx = 0, int depth = 0) {",
            "        int centroid = search_centroid(idx, -1, build_dfs(idx, -1) / 2);",
            "        centroid_depth[centroid] = depth;",
            "        v[centroid] = true;",
            "        belong_dfs(centroid, -1, centroid);",
            "        tree[centroid].clear();",
            "        for (auto &to : g[centroid]) {",
            "            if (!v[to]) {",
            "                int child_centroid = build(to, depth + 1);",
            "                tree[centroid].emplace_back(child_centroid);",
            "            }",
            "        }",
            "        v[centroid] = false;",
            "        return centroid;",
            "    }",
            "};",
        ],
        "description": ""
    },
        "inversion": {
        "prefix": "inversion",
        "body": [
            "//https://atcoder.jp/contests/chokudai_S001/submissions/67254446",
            "#include <atcoder/segtree>",
            "ll op(ll x,ll y){",
            "    return x + y;",
            "}",
            "ll e(){",
            "    return 0;",
            "}",
            "ll inversion(vll a){",
            "    ll n = a.size();",
            "    vll b = a;",
            "    sort(b.begin(), b.end());",
            "    b.erase(unique(b.begin(), b.end()),b.end());",
            "    ll m = b.size();",
            "    atcoder::segtree<ll,op,e> st(m);",
            "    ll res = 0;",
            "    for(int i = n-1;i>=0;i--){",
            "        ll x = a[i];",
            "        auto y = lower_bound(b.begin(), b.end(),x) - b.begin();",
            "        res += st.prod(0,y);",
            "        st.set(y,st.get(y)+1); ",
            "    }",
            "    return res;",
            "}",
        ],
        "description": ""
    },
        "factorization": {
        "prefix": "factorization",
        "body": [
            "vll factorization(ll n){",
            "    vll res;",
            "    if(n == 1){",
            "        res.push_back(1);",
            "        return res;",
            "    }",
            "    ll m = n;",
            "    for(ll i = 2;i * i <= m;i++){",
            "        while(n % i == 0){",
            "            res.push_back(i);",
            "            n /= i;",
            "        }",
            "    }",
            "    if(n != 1){",
            "        res.push_back(n);",
            "    }",
            "    return res;",
            "}",
        ],
        "description": ""
    },
        "totient": {
        "prefix": "totient",
        "body": [
            "vll factorization(ll n){",
            "    vll res;",
            "    if(n == 1){",
            "        res.push_back(1);",
            "        return res;",
            "    }",
            "    ll m = n;",
            "    for(ll i = 2;i * i <= m;i++){",
            "        while(n % i == 0){",
            "            res.push_back(i);",
            "            n /= i;",
            "        }",
            "    }",
            "    if(n != 1){",
            "        res.push_back(n);",
            "    }",
            "    return res;",
            "}",
            "",
            "ll totient(ll n){",
            "    if(n == 1){return 1;}",
            "    ll res = n;",
            "    vll x = factorization(n);",
            "    x.erase(unique(x.begin(),x.end()),x.end());",
            "    for(ll y:x){",
            "        res *= (y - 1);",
            "        res /= y;",
            "    }",
            "    return res;",
            "}",
        ],
